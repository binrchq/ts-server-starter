# ─── ts-server-starter 环境变量 ───────────────────────────────────────────────
# 优先级：CLI 参数 > 环境变量 > config.yaml > 内置默认值
#
# 嵌套配置用**双下划线**表示层级，字段名用 snake_case：
#   SERVER__ADMIN_PORT=3100   →  server.adminPort
#   DATABASE__HOST=db         →  database.host
#
# 两个刻意的设计：
#   1. 未知路径会被静默忽略（写错 SERVER__PROT 不会污染配置树）
#   2. 类型按默认值推断，所以 port 这类字段不需要你手动转数字
#
# 只有下面这些变量会被读取：别名（见 src/config/loader.ts 的 ENV_ALIASES）
# 与 `${顶层键}__${子键}` 形式。其它环境变量不会进入配置。

# ─── 运行环境 ─────────────────────────────────────────────────────────────────
# dev | test | staging | prod
ENVIRONMENT=dev
# 便于灰度时区分实例
APP__NODE_ID=node-local-1

# ─── HTTP 多端口 ──────────────────────────────────────────────────────────────
# outer：浏览器/客户端，唯一允许 Cookie 的端口
SERVER__PORT=4600
# admin：运营后台（要求 admin 角色）
SERVER__ADMIN_PORT=4601
# inner：服务间调用，需要 SECURITY__INTERNAL_TOKEN
SERVER__INTERNAL_PORT=4602
# openapi：第三方，只用 X-Api-Key
SERVER__OPENAPI_PORT=4603
# metrics：Prometheus 抓取；0 = 关闭
SERVER__METRICS_PORT=4604

# 生产环境在 Nginx/ALB 之后时填 1（信任一层代理）。
# 不要填 true：express-rate-limit 会判定为不安全配置并 warn，
# 因为「无限信任」等于允许客户端伪造 X-Forwarded-For 绕过限流。
SERVER__TRUST_PROXY=0

# ─── 数据库 ───────────────────────────────────────────────────────────────────
# driver: postgres | mysql | sqlite | mongodb | prisma
DATABASE__DRIVER=postgres
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=starter_db
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=change-me
# 表所在 schema（postgres）；Prisma 驱动必须显式给出，适配器不读 URL 里的 search_path
DATABASE__SCHEMA=public

# ─── 动态分表守护（可选）──────────────────────────────────────────────────
# 开启后按 DATABASE__SHARDING__FORMAT 提前建下一期分表，避免首次写入才报“表不存在”
DATABASE__SHARDING__ENABLED=false
DATABASE__SHARDING__CHECK_INTERVAL_MS=21600000
DATABASE__SHARDING__PREPARE_ADVANCE_MS=259200000
DATABASE__SHARDING__FORMAT=YYYYMM
DATABASE__SHARDING__CHECK_EXISTS=true

# 也可以直接给整串 DSN（优先级高于上面的分项配置）
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/starter_db?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS__HOST=localhost
REDIS__PORT=6379
# REDIS_URL=redis://:password@localhost:6379/0

# ─── 缓存 / 消息队列 / 分布式状态 ─────────────────────────────────────────────
# 本地开发全用 memory，避免为了跑一个 demo 装 Redis
CACHE__DRIVER=memory
MQ__DRIVER=memory
STATE__DRIVER=memory
STATE__ENABLED=true
# driver=etcd 时必填（逗号分隔）
# STATE__ENDPOINTS=http://127.0.0.1:2379
STATE__KEY_PREFIX=state:

# ─── 验证码（短信 / 邮箱）──────────────────────────────────────────────────
# 存储走 state adapter，发送默认写日志；生产请注入真实 sender
VERIFICATION__ENABLED=true
VERIFICATION__LENGTH=6
VERIFICATION__TTL_MS=300000
VERIFICATION__MAX_ATTEMPTS=5
VERIFICATION__COOLDOWN_MS=60000
VERIFICATION__DAILY_LIMIT=10
# 仅 dev/test 可开；prod 开启会直接启动失败
VERIFICATION__EXPOSE_IN_LOGS=false

# ─── 日志 ─────────────────────────────────────────────────────────────────────
# debug | info | warn | error | fatal | silent
LOGGING__LEVEL=debug
# json（生产，便于采集）| text（本地，便于阅读）
LOGGING__FORMAT=text
# stdout | file
LOGGING__OUTPUT=stdout
# LOGGING__OUTPUT=file 时生效，自带按大小轮转
LOGGING__FILE_PATH=./logs/app.log

# ─── 安全（生产环境必填）───────────────────────────────────────────────────────
# 会话/令牌签名密钥，>= 32 字符。生成：openssl rand -hex 32
# 留空或过短时：dev 打 warn，prod 直接启动失败（fail-closed）
SECURITY__SESSION_SECRET=
# 内网路由共享密钥；留空则 inner 端口的所有请求返回 503
SECURITY__INTERNAL_TOKEN=
# 允许跨域的来源，逗号分隔。生产环境必须显式配置，否则启动时 warn
SECURITY__ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# 只有前面的 LB 已经终止 TLS 时才开；本地开会让浏览器强制跳 https
SECURITY__ENABLE_HSTS=false

# ─── 限流 ─────────────────────────────────────────────────────────────────────
SECURITY__RATE_LIMIT__ENABLED=true
SECURITY__RATE_LIMIT__MAX=300
SECURITY__RATE_LIMIT__AUTH_MAX=10

# ─── 审计 ─────────────────────────────────────────────────────────────────────
# 审计事件同时进结构化日志和 audit_logs 表（仅当 security__audit_log=true
# 且数据库是 SQL 驱动时才会落库）。写入走有界内存队列 + 定时批量提交。
#
# 队列满时丢弃**最新**事件并累加 dropped 计数 —— 刻意选这个方向：
# 保留最早的攻击样本比保留最新的更有价值，且可用性优先于审计完整性。
# 丢弃/失败计数通过 GET /admin/audit/tail 的 stats 字段暴露，请接告警。
SECURITY__AUDIT_LOG=true
# 队列容量。按峰值 QPS × 落库延迟估算；1 万以上要留意进程内存
SECURITY__AUDIT_QUEUE_CAPACITY=1000
# 攒够多少条就立刻写库（不必等定时器）
SECURITY__AUDIT_BATCH_SIZE=20
# 定时冲刷间隔（毫秒）。太大则崩溃时丢的窗口更宽，太小则写库次数更频繁
SECURITY__AUDIT_FLUSH_INTERVAL_MS=2000

# ─── 开发便利（生产环境启用会直接抛错）─────────────────────────────────────────
# 跳过登录，直接以 DEV_USER_ID 的身份访问受保护接口
DEV_AUTH_BYPASS=0
DEV_USER_ID=dev-user-0001
DEV_USER_ROLES=user,admin